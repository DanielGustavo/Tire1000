# Copie para .env e preencha antes de rodar `serverless deploy` (só o dev roda comandos do
# Serverless — nunca um agente). O Serverless Framework carrega .env automaticamente.

# Dashboard do Stripe → Developers → API keys (chave secreta, não a publishable)
STRIPE_SECRET_KEY=

# Dashboard do Stripe → Product catalog → Price cadastrado como "1 crédito" (ADR-0002)
STRIPE_PRICE_ID=

# Dashboard do Stripe → Developers → Webhooks → endpoint de /credits/webhook → Signing secret
STRIPE_WEBHOOK_SECRET=

# URL pública do front (usada para montar o success_url/cancel_url do Stripe Checkout)
FRONTEND_URL=

# Google AI Studio (https://aistudio.google.com/apikey) — usada pelo ValidateEssay (Revisão) pra
# chamar o Gemini
GEMINI_API_KEY=

# Email que recebe os alertas de falha de sistema e de usuário com muitas rejeições (SNS,
# ValidateEssay) — confirme a inscrição no SNS antes de esperar os emails chegarem
DEV_ALERT_EMAIL=

# Preenchido automaticamente pelo serverless.yml (ThemeAssetsDistribution) em deploy — não precisa
# setar manualmente. Base pública das imagens de Texto motivador (fileKey do seed vira
# `${THEME_ASSETS_CDN_DOMAIN}/${fileKey}`); pra rodar local, aponte pra qualquer CDN de teste ou
# deixe em branco.
THEME_ASSETS_CDN_DOMAIN=
